# ============================================
# Suricata Dashboard - Docker Environment
# ============================================
# Copy this file to .env and customize values

# --------------------------------------------
# Flask Configuration
# --------------------------------------------
FLASK_PORT=5000
FLASK_DEBUG=False

# --------------------------------------------
# Dashboard Settings
# --------------------------------------------
DASHBOARD_NAME=Suricata Dashboard
TRAFFIC_AGGREGATION_INTERVAL=300
DB_STORE_TIME=60

# --------------------------------------------
# Suricata Host Paths (mount points)
# --------------------------------------------
# These paths point to Suricata installation on your HOST machine
HOST_SURICATA_CONFIG=/etc/suricata
HOST_SURICATA_LOG=/var/log/suricata

# Suricata binary and internal container paths
SURICATA_BINARY_PATH=suricata
SURICATA_CONFIG_PATH=/etc/suricata/suricata.yaml
SURICATA_RULES_DIR=/etc/suricata/rules
SURICATA_LOG_DIR=/var/log/suricata

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Choose: postgresql or mysql
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=suricata
DB_PASSWORD=changeme
DB_NAME=suricata
DB_RETENTION_DAYS=30

# For MySQL, use these settings:
# DB_TYPE=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=suricata
# DB_PASSWORD=changeme
# DB_NAME=suricata

# --------------------------------------------
# Application Settings
# --------------------------------------------
AUTO_REFRESH_INTERVAL=5000
LOG_LINES_LIMIT=100
MAX_RULE_FILE_SIZE=1048576

# Auto-restart settings
AUTO_RESTART_ENABLED=False
AUTO_RESTART_MAX_RETRIES=3
AUTO_RESTART_CHECK_INTERVAL=30

# --------------------------------------------
# SSL/TLS Configuration (Optional)
# --------------------------------------------
USE_HTTPS=False
SSL_CERT_PATH=binary/certificates/cert.pem
SSL_KEY_PATH=binary/certificates/key.pem
