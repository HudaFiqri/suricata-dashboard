# Suricata Configuration
SURICATA_BINARY_PATH=suricata
SURICATA_CONFIG_PATH=/etc/suricata/suricata.yaml
SURICATA_RULES_DIR=/etc/suricata/rules

# Suricata Log Directory
SURICATA_LOG_DIR=/var/log/suricata
SURICATA_LOG_EVE=/var/log/suricata/eve.json
SURICATA_LOG_STATS=/var/log/suricata/stats.log
SURICATA_LOG_FAST=/var/log/suricata/fast.log
SURICATA_LOG_ALERTS=/var/log/suricata/alerts.log

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=80
FLASK_DEBUG=False
SECRET_KEY=change-this-to-random-secret-key-in-production

# Dashboard Settings
SURICATA_DASHBOARD_NAME=Suricata Dashboard
AUTO_REFRESH_INTERVAL=5000
LOG_LINES_LIMIT=100
MAX_RULE_FILE_SIZE=1048576
TRAFFIC_AGGREGATION_INTERVAL=300

# PostgreSQL Configuration
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=suricata
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# JWT Configuration
JWT_SECRET_KEY=change-this-to-random-secret-key-in-production
JWT_EXPIRATION_HOURS=24

# Agent Configuration
AGENT_TOKEN_ENCRYPTION_KEY=change-this-to-32-byte-base64-key

# WebSocket Configuration
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_PING_INTERVAL=25

# Data Retention (days)
EVENTS_RETENTION_DAYS=90
LOGS_RETENTION_DAYS=30
STATS_RETENTION_DAYS=365
DB_RETENTION_DAYS=30

# Certificate Settings
USE_HTTPS=False
SSL_CERT_PATH=binary/certificates/cert.pem
SSL_KEY_PATH=binary/certificates/key.pem

# Auto-restart Settings
AUTO_RESTART_ENABLED=False
AUTO_RESTART_MAX_RETRIES=3
AUTO_RESTART_CHECK_INTERVAL=30

# Application Storage Paths
APP_DATA_DIR=/opt/suricata_monitoring/data
APP_LOG_DIR=/opt/suricata_monitoring/log
RRD_DIR=/opt/suricata_monitoring/data/rrd


